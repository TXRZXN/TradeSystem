// Contact: naruechat.b@gmail.com
//@version=5
strategy("Mean Reversion Donchian", overlay=true,precision=6,initial_capital = 1000,pyramiding = 5)
//***************************************** Input *****************************************//


source = input.source(close,title = "Source For Calculate",group = "Indicator Setting")
MarkBuySig = input(defval=true, title='Display Buy Signal',group = "Indicator Setting")
length = input.int(30, minval=1,group = "Indicator Setting")
xtf = input.timeframe('D',title = "timeframe",group = "Indicator Setting")
matype = input.string(defval = "EMA",title = "MA Type",options = ["EMA","SMA"],group = "Indicator Setting")

typetrade = input.string(defval = "Crypto",title = "Tyep Of PositionSize",options = ["Crypto","Forex"])
lot =input.float(defval = 0.01,title = "Lot Size")*100

Buysig = input(defval=false, title='Start Strategy',group = "Strategy Setting")
UseSl = input(defval = false,title = "Close With SL",group = "Strategy Setting")
SLDAY = input(defval = 10,title = "Bar To Calculate ATR SL",group = "Strategy Setting")
atrmul = input.float(defval = 2.3,title = "ATR Mul",group = "Strategy Setting")
Risk_Per_Trade = input(1, '% of Risk Per Trade',group = "Strategy Setting") / 100  // Risk% Per Trade Switch
slType = input.string(defval = "Trailing",title = "Stop Loss  Type",options = ["Trailing","Previous Low"],group = "Strategy Setting")
//***************************************** Calculator *****************************************//


upper = ta.highest(length)[1]
lower = ta.lowest(length)[1]
basis = (upper+lower)/2


Bull =  ta.crossover(close, lower) 
Bear = ta.crossover(close, basis)

Green = Bull // Buy
Red = Bear  // Sell

buycond = Green and Green[1] == 0
sellcond = Red and Red[1] == 0

bullish = ta.barssince(buycond) < ta.barssince(sellcond)
bearish = ta.barssince(sellcond) < ta.barssince(buycond)

buy = bearish[1] and buycond
sell = bullish[1] and sellcond

plotshape(MarkBuySig ? Bull : na, style=shape.labelup, text='Buy', textcolor=color.new(color.black, 0), location=location.belowbar, color=color.new(color.green, 0))
plotshape(MarkBuySig ? sell : na, style=shape.labeldown, text='Sell', textcolor=color.new(color.black, 0), location=location.abovebar, color=color.new(color.red, 0))

plot(basis,color = color.white)
plot(upper,color = color.blue)
plot(lower,color = color.blue)

use_date_range = input(true,title =  "Use Date Range",group = "Backtest Setting")
FromYear = input.int(defval=2012, title='From Year', minval=1800,group = "Backtest Setting")
FromMonth = input.int(defval=1, title='From Month', minval=1,group = "Backtest Setting")
FromDay = input.int(defval=1, title='From Day', minval=1,group = "Backtest Setting")
ToYear = input.int(defval=9999, title='To Year', minval=1950,group = "Backtest Setting")
ToMonth = input.int(defval=1, title='To Month', minval=1,group = "Backtest Setting")
ToDay = input.int(defval=1, title='To Day', minval=1,group = "Backtest Setting")
in_date_range = use_date_range ? time > timestamp(FromYear, FromMonth, FromDay, 00, 00) and time < timestamp(ToYear, ToMonth, ToDay, 23, 59) : true

//****************************************************************************//

//////////////////////////////////////////////
//    define strategy entry / exit          //
//////////////////////////////////////////////

//****************************************************************************//
// LONG CONDITIONS

Select_Long_Condition_1 = Bull   // Buy when Have Signal
Open_Long_Condition = Select_Long_Condition_1 and strategy.opentrades < 6

//****************************************************************************//
// STOP LOSS Price

// longSL = ta.lowest(low, SLDAY)[1]
ATR = ta.atr(SLDAY)
Stop = atrmul*ATR

var ATRTrailingStop = 0.0
ATRTrailingStop := if close>ATRTrailingStop[1] and close[1]>ATRTrailingStop[1]
    math.max(ATRTrailingStop[1], close-Stop)
else if close<ATRTrailingStop[1] and close[1]<ATRTrailingStop[1]
    math.min(ATRTrailingStop[1], close+Stop)
else if close>ATRTrailingStop[1]
    close-Stop 
else 
    close+Stop

SlAtr =  slType == "Trailing" ? math.min(ATRTrailingStop, close-Stop) :ta.lowest(SLDAY)
float longSL = na
longSL := buy ?  SlAtr : longSL[1]  
// longSL := bullish ?  longSL[1] : SlAtr  
// plot(longSL,color = color.red)


//****************************************************************************//
// Cal StopLoss

Long_Entry_Price = close
Diff_OPEN_to_SL = math.abs(Long_Entry_Price - longSL)

// Exit CONDITIONS

Exit_Long_Condition = sell  // Sell when Have Signal

//****************************************************************************//
// POSITION SIZE CAP

float portSize =strategy.netprofit + strategy.initial_capital 
float LossAmoutUnit = math.abs(portSize * Risk_Per_Trade)
float PercentSL = ( Diff_OPEN_to_SL / Long_Entry_Price ) * 100
float PositionSize = LossAmoutUnit / Diff_OPEN_to_SL

float postiontrade = typetrade == "Crypto" ? PositionSize : lot
bool isCrypto = typetrade == "Crypto"
//****************************************************************************//
// ENTRY/EXIT

if Buysig
    if Open_Long_Condition and in_date_range and Bull
        strategy.entry('LONG', strategy.long, qty=postiontrade,comment = str.tostring(longSL))

if Exit_Long_Condition and in_date_range and isCrypto
    strategy.close('LONG')

if close < longSL and UseSl and isCrypto
    strategy.close('LONG')

if not isCrypto and UseSl and in_date_range
    strategy.exit("exit","LONG",limit = basis,stop = longSL,alert_loss = "SL",alert_profit = "TP")

if not isCrypto and in_date_range
    strategy.exit("exit2","LONG",limit = basis,alert_loss = "SL",alert_profit = "TP")


//****************************************************************************//
// PLOT STOP LOSS

longPlotSL = strategy.opentrades > 0 and strategy.position_size > 0 ? longSL : na
var test2 = longPlotSL[0]
plot(longPlotSL, title="", linewidth=2, style=plot.style_linebr, color=color.new(color.red, 0))

//****************************************************************************//





