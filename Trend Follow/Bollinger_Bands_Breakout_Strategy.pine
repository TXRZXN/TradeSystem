// Contact: naruechat.b@gmail.com
//@version=5
strategy("Best Bollinger Bands BreakOut", overlay=true,precision = 6 ,initial_capital = 1000, commission_value = 0.2)

isShowSig = input(defval = true,title = 'Show Buy/Sell Signal',group = "Indicator Settting")
length = input.int(30, title = "Length EMA",group = "Indicator Settting")
mult = input.float(1, title = "Multi  SD",group = "Indicator Settting")
xtf = input.timeframe(title='** Fix chart to which time frame ? **)', defval='D',group = "Indicator Settting")
maType = input.string(defval = "EMA",options = ["EMA","SMA"],title = "MA Type",group = "Indicator Settting")

isTrade = input(defval = false,title = 'Start Strategy',group = "Strategy Settting")
compound = true
UseSL = input(defval = false,title = 'Use Stop Loss',group = "Strategy Settting")
Risk_Per_Trade = input(5, '% of Risk Per Trade',group = "Strategy Settting") / 100  // Risk% Per Trade Switch
SLDAY = input(title='Stop Lose Bars', defval=10,group = "Strategy Settting")
mul = input(title='Multi For SL', defval=2.3,group = "Strategy Settting")

slType = input.string(title = "Stop Loss Type", defval = "SD", options = ["Low", "Trailing","SD","Lower Band"], display = display.data_window,group = "Strategy Settting")

use_date_range = input(defval = true ,title = "Use Date Range")
source = close
//////////////////////////////////////////////--- Calculator Bollinger Band ---//////////////////////////////////////////////
basis =maType =="EMA" ?  ta.ema(source, length) :ta.sma(source,length)
basisSrc = request.security(syminfo.tickerid, xtf, basis)
dev = mult * ta.stdev(source, length)
devSRC = request.security(syminfo.tickerid, xtf, dev)
upper = basisSrc + devSRC
lower = basisSrc - devSRC
bbr = (source - lower)/(upper - lower)

buyEntry = ta.crossover(close,upper)
sellEntry =ta.crossunder(close,lower)

buyCond = buyEntry and buyEntry[1] == 0
sellCond = sellEntry and sellEntry[1] == 0

bullish = ta.barssince(buyCond) < ta.barssince(sellCond)
bearish  = ta.barssince(buyCond) > ta.barssince(sellCond)

buy = bearish[1] and buyCond 
sell = bullish[1] and sellCond 

//////////////////////////////////////////////--- plot ---//////////////////////////////////////////////
plot(basis, "Basis", color= bullish ? color.green : color.red )
upperLine = plot(upper, "Upper", color=#2962FF)
lowerLine = plot(lower, "Lower", color=#2962FF)
fill(upperLine, lowerLine,color =  color.new(color.white,95))
plotshape(isShowSig ? buy : na, style=shape.labelup, text='Buy Next Bar', textcolor=color.new(color.black, 0), location=location.belowbar, color=color.new(color.green, 0))
plotshape(isShowSig ? sell : na, style=shape.labeldown, text='Sell Next Bar', textcolor=color.new(color.black, 0), location=location.abovebar, color=color.new(color.red, 0))


//////////////////////////////////////////////--- start strategy ---//////////////////////////////////////////////

FromYear = input.int(defval=2000, title='From Year', minval=1950)
FromMonth = input.int(defval=1, title='From Month', minval=1)
FromDay = input.int(defval=1, title='From Day', minval=1)
ToYear = input.int(defval=9999, title='To Year', minval=1950)
ToMonth = input.int(defval=1, title='To Month', minval=1)
ToDay = input.int(defval=1, title='To Day', minval=1)
in_date_range = use_date_range ? time > timestamp(FromYear, FromMonth, FromDay, 00, 00) and time < timestamp(ToYear, ToMonth, ToDay, 23, 59) : true
////////////////////////////////////////////////--- LONG CONDITIONS ---//////////////////////////////////////////////
Select_Long_Condition_1 = buy // Buy when Have Signal
Open_Long_Condition = Select_Long_Condition_1 and strategy.opentrades == 0
//////////////////////////////////////////////--- STOP LOSS Price ---//////////////////////////////////////////////
// longSL = ta.lowest(low, SLDAY)[1]


ATR = ta.atr(SLDAY)
Stop = mul*ATR

var ATRTrailingStop = 0.0
ATRTrailingStop := if close>ATRTrailingStop[1] and close[1]>ATRTrailingStop[1]
    math.max(ATRTrailingStop[1], close-Stop)
else if close<ATRTrailingStop[1] and close[1]<ATRTrailingStop[1]
    math.min(ATRTrailingStop[1], close+Stop)
else if close>ATRTrailingStop[1]
    close-Stop 
else 
    close+Stop

SD = ta.stdev(close,SLDAY)
sdtrail = SD*mul
SlSd = close - sdtrail


SlAtr =  slType == "Trailing" ? math.min(ATRTrailingStop, close-Stop) : slType == "SD" ? SlSd :  slType == "Low" ? ta.lowest(SLDAY) : lower

float longSL = na
longSL := Open_Long_Condition ?  SlAtr : longSL[1]  
plot( longSL)

////////////////////////////////////////////////--- Cal StopLoss ---//////////////////////////////////////////////
Long_Entry_Price = close
Diff_OPEN_to_SL = math.abs(Long_Entry_Price - longSL)
////////////////////////////////////////////////--- Exit CONDITIONS ---//////////////////////////////////////////////
Exit_Long_Condition = sell  // Sell when Have Signal
////////////////////////////////////////////////--- POSITION SIZE CAP ---//////////////////////////////////////////////
float portSize = compound ? strategy.netprofit + strategy.initial_capital : strategy.initial_capital
float LossAmoutUnit = portSize * Risk_Per_Trade
float PercentSL = ( Diff_OPEN_to_SL / Long_Entry_Price ) * 100
float PositionSize = LossAmoutUnit / Diff_OPEN_to_SL
////////////////////////////////////////////////--- ENTRY/EXIT ---//////////////////////////////////////////////

if isTrade
    if Open_Long_Condition  and buyEntry and in_date_range
        strategy.entry('LONG', strategy.long, qty=PositionSize)
 
if Exit_Long_Condition and in_date_range
    strategy.close('LONG')

if low < longSL and UseSL
    strategy.close('LONG')

if use_date_range and not in_date_range
    strategy.close('LONG')

////////////////////////////////////////////////--- PLOT STOP LOSS ---//////////////////////////////////////////////
longPlotSL = strategy.opentrades > 0 and strategy.position_size > 0 ? longSL : na
plot(longPlotSL, title="", linewidth=2, style=plot.style_linebr, color=color.new(color.orange, 0))
