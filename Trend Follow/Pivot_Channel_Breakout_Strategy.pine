//@version=5
strategy("Pivot Channel Breakout", overlay=true,precision = 6 ,initial_capital = 1000, commission_value = 0.2)
dayinput = input(defval = 22,title = 'Bar to Calculate')
MarkBuySig =  input(defval=true, title='Show Signal',group = "Strategy Setting")
Buysig = input(defval=false, title='Start Strategy',group = "Strategy Setting")
UseSl = input(defval=false, title='Use Stoploss Price',group = "Strategy Setting")
Compound = input(defval = true ,title =  "Compound Profit(กำไรทบต้น)",group = "Strategy Setting")
Risk_Per_Trade = input(5, '% of Risk Per Trade',group = "Strategy Setting") / 100  // Risk% Per Trade Switch
slType = input.string(title = "Stop Loss Type", defval = "SD", options = ["Low", "Trailing","SD","Resistance"], display = display.data_window,group = "Strategy Setting")
SLDAY = input(title='Bars Previous Calculate SL', defval=10,group = "Strategy Setting")
Mul = input(title='ATR MUl', defval=2.3,group = "Strategy Setting")

highed = ta.ema(high,dayinput)
lowed = ta.ema(low,dayinput)
closed = ta.ema(close,dayinput)
pivot = (highed+lowed+closed)/3
rOne = (2*pivot)-lowed
sOne = (2*pivot)-highed
rTwo = pivot+(highed-lowed)
sTwo = pivot-(highed-lowed)
rThree = pivot*2 + (highed-2*lowed)
sThree =  pivot*2 - (2*highed-lowed)
rfour = pivot*3 + (highed-3*lowed)
sfour =  pivot*3 - (3*highed-lowed)

Bull = ta.crossover(close,rTwo)
Bear = ta.crossunder(close,sTwo)

Green = Bull   // Buy
Red = Bear   // Sell

buycond = Green and Green[1] == 0
sellcond = Red and Red[1] == 0

bullish = ta.barssince(buycond) < ta.barssince(sellcond)
bearish = ta.barssince(sellcond) < ta.barssince(buycond)

buy = bearish[1] and buycond
sell = bullish[1] and sellcond

topline = bullish ? rTwo : sTwo
bottomLine = bullish ? sTwo :rTwo

plot(pivot, style=plot.style_line, color=color.white, title="Pivot ")
plot(bottomLine, style=plot.style_line, color=color.red, title="Resistance")
plot(topline, style=plot.style_line, color=color.green, title="Support")

plotshape(MarkBuySig ? buy : na, style=shape.labelup, text='Buy Next Bar', textcolor=color.new(color.black, 0), location=location.belowbar, color=color.new(color.green, 0))
plotshape(MarkBuySig ? sell : na, style=shape.labeldown, text='Sell Next Bar', textcolor=color.new(color.black, 0), location=location.abovebar, color=color.new(color.red, 0))

fillcolor = Bull ? color.green : Bear ? color.red : color.black


// === BACKTEST RANGE === //
use_date_range = input(true,title =  "Use Date Range",group = "Backtest Setting")
FromYear = input.int(defval=2000, title='From Year', minval=1950,group = "Backtest Setting")
FromMonth = input.int(defval=1, title='From Month', minval=1,group = "Backtest Setting")
FromDay = input.int(defval=1, title='From Day', minval=1,group = "Backtest Setting")
ToYear = input.int(defval=9999, title='To Year', minval=1950,group = "Backtest Setting")
ToMonth = input.int(defval=1, title='To Month', minval=1,group = "Backtest Setting")
ToDay = input.int(defval=1, title='To Day', minval=1,group = "Backtest Setting")
in_date_range = use_date_range ? time > timestamp(FromYear, FromMonth, FromDay, 00, 00) and time < timestamp(ToYear, ToMonth, ToDay, 23, 59) : true

//****************************************************************************//

//////////////////////////////////////////////
//    define strategy entry / exit          //
//////////////////////////////////////////////

//****************************************************************************//
// LONG CONDITIONS

Select_Long_Condition_1 = Bull   // Buy when Have Signal
Open_Long_Condition = Select_Long_Condition_1 and strategy.opentrades == 0

//****************************************************************************//
// STOP LOSS Price

// longSL = ta.lowest(low, SLDAY)[1]
ATR = ta.atr(SLDAY)
Stop = Mul*ATR

var ATRTrailingStop = 0.0
ATRTrailingStop := if close>ATRTrailingStop[1] and close[1]>ATRTrailingStop[1]
    math.max(ATRTrailingStop[1], close-Stop)
else if close<ATRTrailingStop[1] and close[1]<ATRTrailingStop[1]
    math.min(ATRTrailingStop[1], close+Stop)
else if close>ATRTrailingStop[1]
    close-Stop 
else 
    close+Stop


SD = ta.stdev(close,SLDAY)
sdtrail = SD*Mul
SlSd = close - sdtrail


SlAtr =  slType == "Trailing" ? math.min(ATRTrailingStop, close-Stop) : slType == "SD" ? SlSd :  slType == "Low" ? ta.lowest(SLDAY) :sTwo
// plot(math.min(ATRTrailingStop, close-Stop))
float longSL = na
longSL := Open_Long_Condition ?  SlAtr : longSL[1]  


//****************************************************************************//
// Cal StopLoss

Long_Entry_Price = close
Diff_OPEN_to_SL = math.abs(Long_Entry_Price - longSL)

// Exit CONDITIONS

Exit_Long_Condition = Red and Red[1] == 0  // Sell when Have Signal

//****************************************************************************//
// POSITION SIZE CAP

float portSize = Compound ? strategy.netprofit + strategy.initial_capital : strategy.initial_capital
float LossAmoutUnit = portSize * Risk_Per_Trade
float PercentSL = ( Diff_OPEN_to_SL / Long_Entry_Price ) * 100
float PositionSize = LossAmoutUnit / Diff_OPEN_to_SL


//****************************************************************************//
// ENTRY/EXIT

if Buysig
    if Open_Long_Condition and in_date_range and Bull
        strategy.entry('LONG', strategy.long, qty=PositionSize,comment = str.tostring(longSL))


if Exit_Long_Condition and in_date_range
    strategy.close('LONG')

if close < longSL and UseSl
    strategy.close('LONG')

if use_date_range and not in_date_range
    strategy.close('LONG')



entryprice = strategy.opentrades.entry_price(0)
slPrice = str.tonumber(strategy.opentrades.entry_comment(0))
diff = entryprice - slPrice

rr1 = entryprice + diff
rr2 = entryprice +(diff*2)
// if diff == 0
//     rr1 := entryprice + (entryprice-oldSl)
// else
    
// rr2 =  entryprice + (diff*2)
// float test = na
// if strategy.opentrades > 0 and close >= rr1 
//     longSL := entryprice
// if strategy.opentrades > 0 and close >= rr2
//     longSL := rr1
//****************************************************************************//
// PLOT STOP LOSS

longPlotSL = strategy.opentrades > 0 and strategy.position_size > 0 ? longSL : na
var test2 = longPlotSL[0]
plot(longPlotSL, title="", linewidth=2, style=plot.style_linebr, color=color.new(color.red, 0))

//****************************************************************************//



