//@version=5
strategy("Breakout PivotHighLow",overlay=true,precision = 6 ,initial_capital = 1000, commission_value = 0.2)
//=============================================================================//
//                        ⚙️ INDICATOR SETTINGS
//=============================================================================//
lengthGroupTitle = "LENGTH LEFT / RIGHT"
leftLenH = input.int(title="Pivot High", defval=10, minval=1, inline="Pivot High", group=lengthGroupTitle)
rightLenH = input.int(title="/", defval=10, minval=1, inline="Pivot High", group=lengthGroupTitle)
leftLenL = input.int(title="Pivot Low", defval=10, minval=1, inline="Pivot Low", group=lengthGroupTitle)
rightLenL = input.int(title="/", defval=10, minval=1, inline="Pivot Low", group=lengthGroupTitle)
typetp = input.string(defval = "Mid",title = "Type TP" , options = ["Bottom","Mid"], group=lengthGroupTitle)

//=============================================================================//
//                        ⚙️ STRATEGY & BACKTEST SETTINGS
//=============================================================================//
Buysig = input(defval=false, title='Start Strategy', group = "Strategy Settings")
UseSl = input(defval=false, title='Use Stop Loss', group = "Strategy Settings")
Compound = input(defval = true ,title =  "Compound Profit(กำไรทบต้น)", group = "Strategy Settings")
Risk_Per_Trade = input(5, '% of Risk Per Trade', group = "Strategy Settings") / 100
slType = input.string(title = "Stop Loss Type", defval = "Trailing", options = ["Pivot Low", "Trailing", "SD"], display = display.data_window, group = "Strategy Settings")
SLDAY = input.int(title='Bars Previous Calculate SL', defval=10, group = "Strategy Settings")
mul = input.float(title='Multiple For Calculate SL', defval=2.3, group = "Strategy Settings")

use_date_range = input(defval = true ,title = "Use Date Range", group = "Backtest Settings")
FromYear  = input.int(defval=2000, title='From Year', minval=1950, group = "Backtest Settings")
FromMonth = input.int(defval=1, title='From Month', minval=1, group = "Backtest Settings")
FromDay   = input.int(defval=1, title='From Day', minval=1, group = "Backtest Settings")
ToYear    = input.int(defval=9999, title='To Year', minval=1950, group = "Backtest Settings")
ToMonth   = input.int(defval=1, title='To Month', minval=1, group = "Backtest Settings")
ToDay     = input.int(defval=1, title='To Day', minval=1, group = "Backtest Settings")
in_date_range = use_date_range ? time > timestamp(FromYear, FromMonth, FromDay, 00, 00) and time < timestamp(ToYear, ToMonth, ToDay, 23, 59) : true

//=============================================================================//
//                        🧮 INDICATOR CALCULATIONS
//=============================================================================//
var float lastPh = na
var float lastPl = na

ph = ta.pivothigh(leftLenH, rightLenH)
pl = ta.pivotlow(leftLenL, rightLenL)

if not na(ph)
    lastPh := ph

if not na(pl)
    lastPl := pl

midline = (lastPh+lastPl)/2
undertp = typetp =="Bottom" ?lastPl:midline
Bull = ta.crossover(close,lastPh)
Bear = ta.crossunder(close,undertp)

Green = Bull
Red = Bear

buycond = Green and Green[1] == 0
sellcond = Red and Red[1] == 0

bullish = ta.barssince(buycond) < ta.barssince(sellcond)
bearish = ta.barssince(sellcond) < ta.barssince(buycond)

buy = bearish[1] and buycond
sell = bullish[1] and sellcond

plot(lastPh,title = "Last Pivot High")
plot(lastPl,title = "Last Pivot Low")
plot(midline,color = color.white,title = "Middle Line")
plotshape( buy , style=shape.labelup, text='Buy', textcolor=color.new(color.black, 0), location=location.belowbar, color=color.new(color.green, 0),title = "Buy Signal")
plotshape( sell , style=shape.labeldown, text='Sell', textcolor=color.new(color.black, 0), location=location.abovebar, color=color.new(color.red, 0),title = "Sell Signal")
//=============================================================================//
//                        🚦 ENTRY & EXIT CONDITIONS
//=============================================================================//
Select_Long_Condition_1 = Bull
Open_Long_Condition = Select_Long_Condition_1 and strategy.opentrades == 0
Exit_Long_Condition = sell

//=============================================================================//
//                        🛑 STOPLOSS CALCULATION
//=============================================================================//
float atr = ta.atr(SLDAY)
float stopATR = mul * atr
float sd = ta.stdev(close, SLDAY)
float stopSD = mul * sd

var float ATRTrailingStop = na
if na(ATRTrailingStop)
    ATRTrailingStop := close - stopATR

ATRTrailingStop := if close > ATRTrailingStop[1] and close[1] > ATRTrailingStop[1]
    math.max(ATRTrailingStop[1], close - stopATR)
else if close < ATRTrailingStop[1] and close[1] < ATRTrailingStop[1]
    math.min(ATRTrailingStop[1], close + stopATR)
else if close > ATRTrailingStop[1]
    close - stopATR 
else 
    close + stopATR

float SlSd = close - stopSD
float SlLow = ta.lowest(low, SLDAY)

float longBaseSL = slType == "Trailing" ? math.min(ATRTrailingStop, close - stopATR) : slType == "SD" ? SlSd : lastPl

float longSL = na
longSL := Open_Long_Condition ? longBaseSL : longSL[1]


//=============================================================================//
//                        ⚖️ POSITION SIZING & MONEY MANAGEMENT
//=============================================================================//
Long_Entry_Price = close
Diff_OPEN_to_SL = math.abs(Long_Entry_Price - longSL)

float rawPortSize = Compound ? strategy.netprofit + strategy.initial_capital : strategy.initial_capital
float portSize = math.max(rawPortSize, 0)
float LossAmoutUnit = portSize > 0 ? portSize * Risk_Per_Trade : 0
float maxQtyAllowed = 1e12
float PositionSize = portSize > 0 and Diff_OPEN_to_SL > 0 ? LossAmoutUnit / Diff_OPEN_to_SL : 0
PositionSize := math.min(PositionSize, maxQtyAllowed)

//=============================================================================//
//                        🚀 EXECUTION (ENTRY/EXIT)
//=============================================================================//
bool canTrade = portSize > 0 and PositionSize > 0 and in_date_range
bool noPosition = strategy.position_size == 0
bool hasLong = strategy.position_size > 0

if Buysig and Open_Long_Condition and canTrade and noPosition
    strategy.entry(id = 'LONG', direction = strategy.long, qty = PositionSize)

bool exitBySignal = Exit_Long_Condition
bool exitBySL     = UseSl and low <= longSL
bool exitByDate   = use_date_range and not in_date_range

if hasLong and (exitBySignal or exitBySL or exitByDate)
    strategy.close('LONG')

float longPlotSL = hasLong and UseSl and not na(longSL) and longSL > 0 ? longSL : na
plot(longPlotSL, title = "Long Stop Loss", linewidth = 2, style = plot.style_linebr, color = color.new(color.red, 0))


