//@version=6
strategy("Month Pivots", overlay = true,precision = 6 ,initial_capital = 1000, commission_value = 0.2)
timeframe = input.timeframe(defval = "1M",title = "timeframe") 
typeInput = input.string("Traditional", "Type", options=["Traditional", "Fibonacci", "Woodie", "Classic", "DM", "Camarilla"])
src = input(defval = close,title = "Source")
buyprice = input.string(defval = "r1",title = "Buy price", options=["p", "r1", "s1", "r2", "s2", "r3","s3", "r4","s4", "r5","s5"])
selprice = input.string(defval = "p",title = "Sell price", options=["p", "r1", "s1", "r2", "s2", "r3","s3", "r4","s4", "r5","s5"])
plotp = input.bool(defval = true,title = "P",inline = "Plot")
plotr1 = input.bool(defval = true,title = "R1",inline = "Plot")
plots1 = input.bool(defval = true,title = "S1",inline = "Plot")
plotr2 = input.bool(defval = false,title = "R2",inline = "Plot")
plots2 = input.bool(defval = false,title = "S2",inline = "Plot")
plotr3 = input.bool(defval = false,title = "R3",inline = "Plot2")
plots3 = input.bool(defval = false,title = "S3",inline = "Plot2")
plotr4 = input.bool(defval = false,title = "R4",inline = "Plot2")
plots4 = input.bool(defval = false,title = "S4",inline = "Plot2")
plotr5 = input.bool(defval = false,title = "R5",inline = "Plot2")
plots5 = input.bool(defval = false,title = "S5",inline = "Plot2")

Buysig = input(defval=false, title='Start Strategy',group = "Strategy Setting")
UseSl = input(defval=true, title='Use Stoploss Price',group = "Strategy Setting")
Compound = true
Risk_Per_Trade = input(5, '% of Risk Per Trade',group = "Strategy Setting") / 100  // Risk% Per Trade Switch
slType = input.string(title = "Stop Loss Type", defval = "SD", options = ["Low", "Trailing","SD","Support"], display = display.data_window,group = "Strategy Setting")
SLDAY = input(title='Previous Bars (Trailing)', defval=10,group = "Strategy Setting")
mul = input(title='Multiple (Trailing)', defval=2.3,group = "Strategy Setting")


weekChange = timeframe.change(timeframe)
pivotPointsArray = ta.pivot_point_levels(typeInput, weekChange)
var float p = 0
var float r1 = 0
var float s1 = 0
var float r2 = 0
var float s2 = 0
var float r3 = 0
var float s3 = 0
var float r4 = 0
var float s4 = 0
var float r5 = 0
var float s5 = 0
if weekChange
    for i = 0 to array.size(pivotPointsArray) - 1
        float pivotLevel = array.get(pivotPointsArray, i)
        if i == 0
            p := pivotLevel
        else if i == 1
            r1 := pivotLevel
        else if i == 2
            s1 := pivotLevel
        else if i == 3
            r2 := pivotLevel
        else if i == 4
            s2 := pivotLevel
        else if i == 5
            r3 := pivotLevel
        else if i == 6
            s3 := pivotLevel
        else if i == 7
            r4 := pivotLevel
        else if i == 8
            s4 := pivotLevel
        else if i == 9
            r5 := pivotLevel
        else if i == 10
            s5 := pivotLevel

plot(plotp ? p : na, title="P", color=color.new(color.blue, 0), linewidth=2) 
plot(plotr1 ? r1 : na, title="R1", color=color.new(color.green, 0), linewidth=1) 
plot(plots1 ? s1 : na, title="S1", color=color.new(color.red, 0), linewidth=1) 
plot(plotr2 ? r2 : na, title="R2", color=color.new(color.green, 0), linewidth=1) 
plot(plots2 ? s2 : na, title="S2", color=color.new(color.red, 0), linewidth=1) 
plot(plotr3 ? r3 : na, title="R3", color=color.new(color.green, 0), linewidth=1) 
plot(plots3 ? s3 : na, title="S3", color=color.new(color.red, 0), linewidth=1) 
plot(plotr4 ? r4 : na, title="R4", color=color.new(color.green, 0), linewidth=1) 
plot(plots4 ? s4 : na, title="S4", color=color.new(color.red, 0), linewidth=1) 
plot(plotr5 ? r5 : na, title="R5", color=color.new(color.green, 0), linewidth=1) 
plot(plots5 ? s5 : na, title="S5", color=color.new(color.red, 0), linewidth=1) 
var float selectedBuyPrice = na
var float selectedSellPrice = na

switch buyprice
    "p" => selectedBuyPrice := p
    "r1" => selectedBuyPrice := r1
    "s1" => selectedBuyPrice := s1
    "r2" => selectedBuyPrice := r2
    "s2" => selectedBuyPrice := s2
    "r3" => selectedBuyPrice := r3
    "s3" => selectedBuyPrice := s3
    "r4" => selectedBuyPrice := r4
    "s4" => selectedBuyPrice := s4
    "r5" => selectedBuyPrice := r5
    "s5" => selectedBuyPrice := s5

switch selprice
    "p" => selectedSellPrice := p
    "r1" => selectedSellPrice := r1
    "s1" => selectedSellPrice := s1
    "r2" => selectedSellPrice := r2
    "s2" => selectedSellPrice := s2
    "r3" => selectedSellPrice := r3
    "s3" => selectedSellPrice := s3
    "r4" => selectedSellPrice := r4
    "s4" => selectedSellPrice := s4
    "r5" => selectedSellPrice := r5
    "s5" => selectedSellPrice := s5



isBull = ta.crossover(src,selectedBuyPrice)
isBear = ta.crossunder(src,selectedSellPrice)
BuyCond = isBull and isBull[1] == false
SellCond = isBear and isBear[1] == false
isBullish = ta.barssince(BuyCond) < ta.barssince(SellCond)
isBearish = ta.barssince(SellCond) < ta.barssince(BuyCond)
buy = isBearish[1] and BuyCond
sell = isBullish[1] and SellCond

plotshape(buy, style=shape.labelup, text='Buy Next Bar', textcolor=color.new(color.black, 0), location=location.belowbar, color=color.new(color.green, 0))
plotshape(sell, style=shape.labeldown, text='Sell Next Bar', textcolor=color.new(color.black, 0), location=location.abovebar, color=color.new(color.red, 0))

// === BACKTEST RANGE === //
use_date_range = input(true,title =  "Use Date Range",group = "Backtest Setting")
FromYear = input.int(defval=2000, title='From Year', minval=1950,group = "Backtest Setting")
FromMonth = input.int(defval=1, title='From Month', minval=1,group = "Backtest Setting")
FromDay = input.int(defval=1, title='From Day', minval=1,group = "Backtest Setting")
ToYear = input.int(defval=9999, title='To Year', minval=1950,group = "Backtest Setting")
ToMonth = input.int(defval=1, title='To Month', minval=1,group = "Backtest Setting")
ToDay = input.int(defval=1, title='To Day', minval=1,group = "Backtest Setting")
in_date_range = use_date_range ? time > timestamp(FromYear, FromMonth, FromDay, 00, 00) and time < timestamp(ToYear, ToMonth, ToDay, 23, 59) : true

//****************************************************************************//

//////////////////////////////////////////////
//    define strategy entry / exit          //
//////////////////////////////////////////////

//****************************************************************************//
// LONG CONDITIONS

Select_Long_Condition_1 = isBull   // Buy when Have Signal
Open_Long_Condition = Select_Long_Condition_1 and strategy.opentrades == 0

//****************************************************************************//
// STOP LOSS Price

// longSL = ta.lowest(low, SLDAY)[1]
ATR = ta.atr(SLDAY)
Stop = mul*ATR

var ATRTrailingStop = 0.0
ATRTrailingStop := if close>ATRTrailingStop[1] and close[1]>ATRTrailingStop[1]
    math.max(ATRTrailingStop[1], close-Stop)
else if close<ATRTrailingStop[1] and close[1]<ATRTrailingStop[1]
    math.min(ATRTrailingStop[1], close+Stop)
else if close>ATRTrailingStop[1]
    close-Stop 
else 
    close+Stop

SD = ta.stdev(src,SLDAY)
sdtrail = SD*mul
SlSd = close - sdtrail

SlAtr =  slType == "Trailing" ? math.min(ATRTrailingStop, close-Stop) : slType == "SD" ? SlSd : slType == "Low" ? ta.lowest(SLDAY) : s1

float longSL = na
longSL := isBearish ?  SlAtr : longSL[1]  
// plot(math.min(ATRTrailingStop, close-Stop),color = color.white)


//****************************************************************************//
// Cal StopLoss

Long_Entry_Price = close
Diff_OPEN_to_SL = math.abs(Long_Entry_Price - longSL)

// Exit CONDITIONS

Exit_Long_Condition = sell  // Sell when Have Signal

//****************************************************************************//
// POSITION SIZE CAP

float portSize = Compound ? strategy.netprofit + strategy.initial_capital : strategy.initial_capital
float LossAmoutUnit = portSize * Risk_Per_Trade
float PercentSL = ( Diff_OPEN_to_SL / Long_Entry_Price ) * 100
float PositionSize = LossAmoutUnit / Diff_OPEN_to_SL


//****************************************************************************//
// ENTRY/EXIT

if Buysig
    if Open_Long_Condition and in_date_range 
        strategy.entry('LONG', strategy.long, qty=PositionSize,comment = str.tostring(longSL))


if Exit_Long_Condition and in_date_range
    strategy.close('LONG')
    
if close < longSL and UseSl
    strategy.close('LONG')

if use_date_range and not in_date_range
    strategy.close('LONG')

// entryprice = strategy.opentrades.entry_price(0)
// slPrice = str.tonumber(strategy.opentrades.entry_comment(0))
// diff = entryprice - slPrice

// rr1 = entryprice + diff
// rr2 = entryprice +(diff*2)
// if diff == 0
//     rr1 := entryprice + (entryprice-oldSl)
// else
    
// rr2 =  entryprice + (diff*2)
// float test = na
// if strategy.opentrades > 0 and close >= rr1 
//     longSL := entryprice
// if strategy.opentrades > 0 and close >= rr2
//     longSL := rr1
//****************************************************************************//
// PLOT STOP LOSS

longPlotSL = strategy.opentrades > 0 and strategy.position_size > 0 ? longSL : na
var test2 = longPlotSL[0]
plot(longPlotSL, title="", linewidth=2, style=plot.style_linebr, color=color.new(color.orange, 0))

//****************************************************************************//





